{% extends "admin/change_form.html" %}

{% block after_field_sets %}
{{ block.super }}

{% if original %}
<div style="margin: 20px 0; padding: 15px; background: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <strong style="font-size: 14px;">📋 BOQ Items</strong>
            <span style="color: #64748b; font-size: 12px; margin-left: 10px;">
                {{ original.boq_items.count }} items
            </span>
        </div>
        <div>
            <a href="{% url 'admin:core_project_boq_list' original.id %}" 
               style="background: #f97316; color: white; padding: 8px 20px; border-radius: 6px; text-decoration: none; display: inline-block; margin-right: 10px;">
                📊 Manage BOQ Items
            </a>
            <a href="{% url 'admin:core_project_boq_add' original.id %}" 
               style="background: #10b981; color: white; padding: 8px 20px; border-radius: 6px; text-decoration: none; display: inline-block;">
                ➕ Add BOQ Item
            </a>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}
